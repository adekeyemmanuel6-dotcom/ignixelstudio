# Public (safe for browser)
NEXT_PUBLIC_SITE_URL=https://ignixel.studio
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only by scripts/create-admin.mjs (run locally).
SUPABASE_SERVICE_ROLE_KEY=

# Email notifications via Resend (https://resend.com). Server-only; set in Vercel, never NEXT_PUBLIC_.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=you@yourdomain.com
# Optional. Until you verify a domain in Resend, leave unset (uses onboarding@resend.dev, which only delivers to your own Resend account email).
RESEND_FROM=
